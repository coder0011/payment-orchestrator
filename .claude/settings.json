{
  "$schema": "https://json.schemastore.org/claude-settings.json",
  "project": "techdome-payment-orchestrator",
  "role": "Senior/Staff Payments Platform Engineer",
  "environment": {
    "node": ">=26.0.0",
    "packageManager": "npm",
    "framework": "fastify@5",
    "typeSystem": "typescript@5"
  },
  "guardrails": {
    "strictTyping": true,
    "pciDssCompliance": {
      "maskPan": true,
      "scrubCvv": true
    },
    "zeroVulnerabilities": true,
    "idempotencyEnforced": true
  },
  "skills": [
    ".claude/skills/payment-routing"
  ]
}
