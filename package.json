{
  "name": "techdome-payment-orchestrator",
  "version": "1.0.0",
  "description": "Enterprise Payments Orchestrator with Cost-Aware Dynamic Routing, Health Floors & Cascading Fallbacks",
  "main": "dist/src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 || >=24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "test:e2e": "tsx --test tests/integration/**/*.test.ts",
    "test:load": "node tests/load/autocannon-bench.js",
    "demo": "powershell -ExecutionPolicy Bypass -File ./scripts/demo.ps1",
    "audit": "npm audit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "autocannon": "^9.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
